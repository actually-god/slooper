/target
*.rs.bk

# makepkg artifacts (e.g. testing an AUR checkout's PKGBUILD in-tree).
# /src/*.tar.gz is live, NOT a relic: an in-tree makepkg run sets
# $srcdir=$PWD/src and drops the fetched slooper-X.Y.Z.tar.gz right there
# (tests/packaging.sh step 8 codifies that layout; AGENT-GUIDE packaging
# rule: never `makepkg -C` inside a checkout, -C wipes $PWD/src). Do not
# remove this line. (A dangling v0.1 symlink once sat under this rule and
# got mistaken for its purpose; it was deleted 2026-11-23.)
/pkg/
*.pkg.tar.zst
/src/slooper-*/
/src/*.tar.gz
/*.tar.gz
effects/.build/
tests/fixtures/gnull-home/

# Scratch logs landing in the repo-root cwd: gate batteries and sabotage
# batteries run from the shell and print their verdicts here, and `git add -A`
# then sweeps them into a commit (bit twice: sab-battery.log @ v132,
# gate_*.log @ v153). Scoped to the repo root by the leading slash, so
# nested logs (target/test-logs/ and friends) are untouched.
/*.log
